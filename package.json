{
  "name": "wingrid",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/import-assets.mjs",
    "assets:ci": "node scripts/restore-ci-assets.mjs",
    "db:migrate": "wrangler d1 migrations apply wingrid --local",
    "db:migrate:remote": "wrangler d1 migrations apply wingrid --remote",
    "db:migrate:preview": "wrangler d1 migrations apply wingrid-preview --remote --config wrangler.preview-migrations.jsonc",
    "dev": "vite",
    "build": "vite build",
    "build:ci": "npm test && npm run assets:ci && npm run build && wrangler deploy --dry-run",
    "deploy": "vite build && wrangler deploy",
    "deploy:ci": "npm run db:migrate:remote && wrangler deploy && node scripts/check-production.mjs",
    "test": "node --test test/*.test.js",
    "rtp": "node scripts/rtp.mjs",
    "character:import": "node scripts/import-character.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.3"
  }
}
