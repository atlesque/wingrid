{
  "name": "wingrid",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/import-assets.mjs",
    "assets:ci": "node scripts/restore-ci-assets.mjs",
    "db:migrate": "wrangler d1 migrations apply wingrid --local",
    "db:migrate:remote": "wrangler d1 migrations apply wingrid --remote",
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "test": "node --test test/*.test.js",
    "character:import": "node scripts/import-character.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.3"
  }
}
